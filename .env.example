# --- Telegram (https://my.telegram.org → API development tools) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
# --- LinkedIn / X (best-effort, inactifs par défaut) ---
LINKEDIN_ENABLED=0
LINKEDIN_COOKIES=
X_ENABLED=0
X_COOKIES=
# --- SMTP optionnel (sinon mailto / Web Share) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Médical : base de données ---
# Laisser vide = SQLite local (data/medical.db)
# Exemple Postgres (docker-compose) :
# DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/medical_db
DATABASE_URL=

# --- Médical : IA ---
# PREFER_OLLAMA=true pour souveraineté locale ; sinon Gemini puis repli Ollama
PREFER_OLLAMA=false
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral
GEMINI_API_KEY=
# Modèle Gemini (gemini-1.5-flash et 2.x retirés pour les nouveaux comptes).
# gemini-flash-latest = alias stable recommandé ; gemini-3-flash-preview = alternative
GEMINI_MODEL=gemini-flash-latest
# Modèle d'embeddings pour la recherche sémantique (SQLite ou pgvector)
GEMINI_EMBED_MODEL=gemini-embedding-001

# --- Médical : auth B2B ---
# MEDICAL_AUTH_OPTIONAL=1 (défaut) : lecture médicale sans token en local
# MEDICAL_AUTH_OPTIONAL=0 : JWT obligatoire sur /api/medical*
MEDICAL_AUTH_OPTIONAL=0
MEDICAL_AUTH_SECRET=change-me-in-production
JWT_TTL_HOURS=72

# --- Docker Postgres (utilisé par docker-compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=medical_db

# --- Scout / marché (gratuit / freemium) ---
# Actions : Yahoo (~15 min) + Stooq backup. Crypto : Binance near-realtime (sans clé).
# Optionnel — débloque quotes actions plus fraîches (quotas free) :
#   MARKET_PROVIDER=finnhub|alphavantage|auto
#   MARKET_API_KEY=ta_cle
MARKET_PROVIDER=auto
MARKET_API_KEY=

# --- Firebase Auth (obligatoire en production) ---
# Créer un projet sur https://console.firebase.google.com
# puis Paramètres du projet > Comptes de service > Générer une clé privée
FIREBASE_CREDENTIALS_JSON=

# --- Production ---
# PYTHON_ENV=production active les protections prod (auth stricte, CORS)
PYTHON_ENV=development
